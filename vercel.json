{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.md", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "*.py", "use": "@vercel/static" },
    { "src": "cutscenes/**", "use": "@vercel/static" },
    { "src": "docs/**", "use": "@vercel/static" },
    { "src": "posts/**", "use": "@vercel/static" },
    { "src": "reports/**", "use": "@vercel/static" },
    { "src": "rosenkranz-app/**", "use": "@vercel/static" },
    { "src": ".github/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/scores", "dest": "/api/scores.js" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/simulate_dri", "dest": "/api/simulate_dri.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
